[
    {
        "test_name": "test_vibevoice_stability",
        "server_params": {
            "model": "microsoft/VibeVoice-1.5B",
            "trust_remote_code": false,
            "serve_args": {
                "tokenizer": "Qwen/Qwen2.5-1.5B",
                "disable_log_stats": true
            }
        },
        "benchmark_params": [
            {
                "dataset_name": "random",
                "backend": "openai-audio-speech",
                "endpoint": "/v1/audio/speech",
                "trust_remote_code": false,
                "duration_sec": 3600,
                "max_concurrency": 4,
                "num_prompts_per_batch": 50,
                "random_input_len": {
                    "min": 20,
                    "max": 500
                },
                "random_output_len": 512,
                "random_range_ratio": 0.0,
                "extra_body": {
                    "max_new_tokens": 512,
                    "response_format": "pcm",
                    "stream": true,
                    "stream_format": "sse"
                },
                "ignore_eos": false,
                "tokenizer": "Qwen/Qwen2.5-1.5B",
                "percentile-metrics": "e2el,audio_rtf,audio_ttfp,audio_duration,audio_underrun"
            }
        ]
    }
]
